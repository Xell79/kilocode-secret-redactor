    {
      "id": "rubygems_key",
      "label": "rubygems_key",
      "regex": "rubygems_[A-Za-z0-9]{48}"
    },
    {
      "id": "jwt",
      "label": "jwt",
      "regex": "eyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}"
    },
    {
      "id": "bearer_token",
      "label": "bearer_token",
      "regex": "Bearer\\s+[A-Za-z0-9\\-._~+/]+=*"
    },
    {
      "id": "basic_auth",
      "label": "basic_auth",
      "regex": "Basic\\s+[A-Za-z0-9+/]{10,}={0,2}"
    },
    {
      "id": "private_key",
      "label": "private_key",
      "regex": "-----BEGIN\\s+(?:RSA\\s+|EC\\s+|ED25519\\s+|DSA\\s+)?PRIVATE\\s+KEY-----[\\s\\S]*?-----END\\s+(?:RSA\\s+|EC\\s+|ED25519\\s+|DSA\\s+)?PRIVATE\\s+KEY-----"
    },
    {
      "id": "database_url",
      "label": "database_url",
      "regex": "(?:postgres|postgresql|mysql|mongodb|mongodb\\+srv|redis):\\/\\/[^:\\s]+:[^@\\s]+@[^\\s]+"
    },
    {
      "id": "sentry_dsn",
      "label": "sentry_dsn",
      "regex": "https:\\/\\/[a-f0-9]{32}@[^\\s/]+\\.ingest\\.sentry\\.io\\/[0-9]+"
    },
    {
      "id": "grafana_api_key",
      "label": "grafana_api_key",
