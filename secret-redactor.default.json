      "label": "doppler_token",
      "regex": "dp\\.st\\.[A-Za-z0-9_-]{40,}"
    },
    {
      "id": "azure_connection_string",
      "label": "azure_connection_string",
      "regex": "DefaultEndpointsProtocol=https?;AccountName=[^;\\s]+;AccountKey=[A-Za-z0-9+/]{86}==[^\\s\"']*"
    },
    {
      "id": "azure_storage_key",
      "label": "azure_storage_key",
      "regex": "AccountKey=([A-Za-z0-9+/]{86}==)",
      "captureGroup": 1
    },
    {
      "id": "azure_sas_token",
      "label": "azure_sas_token",
      "regex": "[?&]sig=([A-Za-z0-9%+/=]{40,})",
      "captureGroup": 1
    },
    {
      "id": "shopify_access_token",
      "label": "shopify_access_token",
      "regex": "shpat_[a-fA-F0-9]{20,}"
    },
    {
      "id": "shopify_custom_app",
