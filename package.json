{
  "name": "kilocode-secret-redactor",
  "version": "0.6.0",
  "description": "Kilo plugin that redacts secrets and PII before model calls and restores them only for approved local tools",
  "type": "module",
  "main": "./dist/plugin.cjs",
  "module": "./dist/plugin.js",
  "types": "./dist/plugin.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "require": "./dist/plugin.cjs"
    },
    "./lib": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "secret-redactor.default.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "npm run typecheck && npm run test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/"
  },
  "keywords": [
    "kilo",
    "kilocode",
    "kilo-plugin",
    "security",
    "secrets",
    "pii",
    "redaction",
    "betterleaks"
  ],
  "author": "casonadams",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Xell79/kilocode-secret-redactor"
  },
  "engines": {
    "node": ">=20",
    "opencode": ">=1.0.0"
  },
  "dependencies": {
    "dotenv": "^17.2.2"
  },
  "peerDependencies": {
    "@kilocode/plugin": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@types/node": "^24.5.2",
    "@kilocode/plugin": "^7.7.9",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
